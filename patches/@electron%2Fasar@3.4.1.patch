--- /dev/null
+++ b/lib/file-pattern.js
@@ -0,0 +1,36 @@
+"use strict";
+const picomatch = require("picomatch");
+
+function compileArchivePattern(pattern, options = {}) {
+    if (typeof pattern !== "string") {
+        throw new TypeError("ASAR patterns must be strings");
+    }
+    if (!options.nocomment && pattern.startsWith("#")) {
+        return () => false;
+    }
+    let negate = false;
+    if (!options.nonegate) {
+        while (pattern.startsWith("!")) {
+            negate = !negate;
+            pattern = pattern.slice(1);
+        }
+    }
+    if (process.platform === "win32") {
+        pattern = pattern.replace(/\\/g, "/");
+    }
+    const matcher = pattern === "" ? value => value === "" : picomatch(pattern, {
+        dot: options.dot === true,
+        nocase: options.nocase === true,
+        nobrace: options.nobrace === true,
+        noext: options.noext === true,
+        noglobstar: options.noglobstar === true,
+        nonegate: true,
+        matchBase: options.matchBase === true && !pattern.includes("/"),
+    });
+    return value => {
+        const matched = matcher(process.platform === "win32" ? value.replace(/\\/g, "/") : value);
+        return negate && !options.flipNegate ? !matched : matched;
+    };
+}
+
+exports.compileArchivePattern = compileArchivePattern;
