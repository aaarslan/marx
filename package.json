{
  "name": "marx",
  "productName": "Marx",
  "version": "0.9.0",
  "description": "A desktop client for Checkmarx One SAST and SCA scans",
  "author": "Marx contributors",
  "license": "MIT",
  "scripts": {
    "dev": "bun scripts/build-wails.ts --run",
    "typecheck": "bun --bun tsc --noEmit -p tsconfig.node.json && bun --bun tsc --noEmit -p tsconfig.web.json",
    "test": "bun --bun vitest run",
    "build": "bun scripts/build-wails.ts",
    "dist:win": "bun scripts/build-wails.ts --installer",
    "dist:win:dir": "bun scripts/build-wails.ts --windows",
    "audit": "bun audit",
    "dist:mac": "bun scripts/build-wails.ts --mac",
    "start": "bun scripts/build-wails.ts --start",
    "verify:runtime": "bun scripts/verify-wails.ts",
    "audit:go": "govulncheck ./native/... ./tools/resources",
    "verify:privacy": "bun scripts/verify-privacy.ts",
    "test:go": "go test -p=2 ./native/... -count=1",
    "verify:packaging": "bun scripts/verify-native-packaging.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wailsio/runtime": "3.0.0",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "private": true,
  "keywords": [
    "checkmarx",
    "sast",
    "sca",
    "macos",
    "security",
    "windows",
    "wails"
  ],
  "type": "module"
}
